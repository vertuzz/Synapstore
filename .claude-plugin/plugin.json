  "author": { "name": "vertuzz", "url": "https://github.com/vertuzz" },
  "homepage": "https://github.com/vertuzz/synapstore",
  "repository": "https://github.com/vertuzz/synapstore",
  "license": "Apache-2.0",
  "keywords": ["memory", "mcp", "vector-database", "knowledge-graph"],
  "mcpServers": {
    "synapstore": {
      "command": "synapstore",
      "args": ["mcp"]
    }
  }
}
